# ==============================================================================
# MOROCCO PRIME SHELTERS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# 
# DISCLAIMER:
# - Leave environment variables empty or populate them with your live keys.
# - Neon Database URL connects the application to your Vercel Neon PostgreSQL.
# - Firebase credentials enable real authentication (Email/Password & Google Sign-In).
# ==============================================================================

# 1. NEON POSTGRESQL DATABASE URL (from Vercel / Neon Console)
DATABASE_URL=

# 2. FIREBASE AUTHENTICATION (FREE TIER - Web Client Credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 3. OPTIONAL SERVER PORT
PORT=3000
