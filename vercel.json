{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "api/health.ts"
    },
    {
      "src": "/api/properties",
      "dest": "api/properties.ts"
    },
    {
      "src": "/api/init-db",
      "dest": "api/init-db.ts"
    },
    {
      "src": "/api/users",
      "dest": "api/users.ts"
    },
    {
      "src": "/api/upload",
      "dest": "api/upload.ts"
    },
    {
      "src": "/api/auth/sync",
      "dest": "api/auth/sync.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
